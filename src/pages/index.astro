---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { cases } from '../data/cases';
import { services } from '../data/services';
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__label">アジア×新規事業</p>
      <h1 class="hero__title">日本から世界へ<br />価値をひろげる</h1>
      <p class="hero__subtitle">NEW VALUES TO THE WORLD</p>
      <a href="/company" class="btn btn--primary">会社情報をみる</a>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <p class="section-label">ABOUT US</p>
      <h2 class="section-title">戦略と実行力でアジアでのビジネスを加速</h2>
      <p class="section-lead">
        私たちは、日本の企業のアジアにおけるビジネス展開をサポートを行うコンサルティング会社です。進出検討時から現地でのオペレーション運営までビジネスのステージにあわせて幅広くご支援しています。
      </p>
      <a href="/company" class="btn btn--outline" style="margin-top: 1.5rem;">会社情報をみる</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="section-label">SERVICES</p>
      <h2 class="section-title">事業の「今」に必要なビジネスサポートを提供</h2>
      <p class="section-lead">シンガポールをはじめ、アジアでの事業開発の各フェーズでのご支援を実施</p>
      <div class="grid-3" style="margin-top: 2.5rem;">
        {services.slice(0, 3).map((s) => (
          <article class="card">
            <p class="section-label">{s.labelEn}</p>
            <h3>{s.labelJa}</h3>
            <p>{s.summary.slice(0, 100)}…</p>
          </article>
        ))}
      </div>
      <a href="/service" class="btn btn--primary" style="margin-top: 2rem;">事業内容をみる</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-label">CASES</p>
      <h2 class="section-title">アレーライズのご支援事例</h2>
      <p class="section-lead">アジアをはじめとする、アレーライズのご支援事例をご紹介します</p>
      <div class="grid-3" style="margin-top: 2.5rem;">
        {cases.map((c) => <CaseCard caseStudy={c} />)}
      </div>
      <a href="/case" class="btn btn--outline" style="margin-top: 2rem;">実績紹介をみる</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-label">CAREER</p>
      <h2 class="section-title">私たちと一緒に働くメンバーを探しています</h2>
      <p class="section-lead">
        私たちはミッション・価値観への共感を何よりも大切に考え、一緒に働くメンバーを探しています。ご興味をお持ちの方は、こちらから情報をご覧いただけます。
      </p>
      <a href="/coming-soon" class="btn btn--primary" style="margin-top: 1.5rem;">採用情報について</a>
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .hero {
    margin-top: var(--header-height);
    min-height: 70vh;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, var(--color-navy) 0%, var(--color-primary-dark) 60%, var(--color-primary) 100%);
    color: #fff;
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/hero.jpg') center/cover no-repeat;
    opacity: 0.15;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding: 4rem 0;
  }

  .hero__label {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    opacity: 0.8;
    margin-bottom: 1rem;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .hero__subtitle {
    font-family: var(--font-en);
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    opacity: 0.7;
    margin-bottom: 2rem;
  }
</style>
