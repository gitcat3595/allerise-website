---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArrowLink from '../../../components/ArrowLink.astro';
import CaseCard from '../../../components/CaseCard.astro';
import CtaSection from '../../../components/CtaSection.astro';
import PageHero from '../../../components/PageHero.astro';
import { getCases } from '../../../data/cases';
import { getLocale, localePath } from '../../../i18n/locale';
import { getSiteMeta, t } from '../../../i18n/ui';

const locale = getLocale(Astro.url);
const site = getSiteMeta(locale);
const cases = getCases(locale);
---

<BaseLayout title={`${t('navCase', locale)} | ${site.name}`}>
  <PageHero label="CASES" title={t('navCase', locale)} image="/images/cases-banner.jpg" />

  <section class="section section--white">
    <div class="container">
      <nav class="breadcrumb" aria-label={t('breadcrumb', locale)}>
        <a href={localePath(locale, '/')}>{t('home', locale)}</a> ・ {t('navCase', locale)}
      </nav>
      <div class="grid-2">
        {cases.map((c) => <CaseCard caseStudy={c} heading="h2" locale={locale} />)}
      </div>
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>
