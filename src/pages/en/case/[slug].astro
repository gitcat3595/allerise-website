---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArrowLink from '../../../components/ArrowLink.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { getCase, getCases } from '../../../data/cases';
import { getLocale, localePath } from '../../../i18n/locale';
import { getSiteMeta, t } from '../../../i18n/ui';

export function getStaticPaths() {
  return getCases('ja').map((c) => ({ params: { slug: c.slug } }));
}

const locale = getLocale(Astro.url);
const { slug } = Astro.params;
const caseStudy = getCase(slug!, locale);

if (!caseStudy) {
  return Astro.redirect(localePath(locale, '/case'));
}
const site = getSiteMeta(locale);
---

<BaseLayout title={`${caseStudy.title} | ${site.name}`} description={caseStudy.overview}>
  <div class="case-detail-hero">
    <div class="container">
      <span class="case-detail-hero__tag">{caseStudy.category}</span>
      <time class="case-detail-hero__date">{caseStudy.date}</time>
      <h1 class="case-detail-hero__title">{caseStudy.title}</h1>
    </div>
    <img src={caseStudy.image} alt="" class="case-detail-hero__image" width="1640" height="480" loading="eager" />
  </div>

  <section class="section section--white">
    <div class="container prose">
      <nav class="breadcrumb">
        <a href={localePath(locale, '/')}>{t('home', locale)}</a> ・
        <a href={localePath(locale, '/case')}>{t('navCase', locale)}</a> ・ {caseStudy.title}
      </nav>

      <h2>{t('client', locale)}</h2>
      <p>{caseStudy.client}</p>

      <h2>{t('projectOverview', locale)}</h2>
      <p>{caseStudy.overview}</p>

      <h2>{t('supportDetails', locale)}</h2>
      {caseStudy.support.map((s) => (
        <div>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}

      <h2>{t('supportResult', locale)}</h2>
      <p>{caseStudy.result}</p>

      <div style="margin-top: 2rem;">
        <ArrowLink href={localePath(locale, '/case')}>{t('backToCases', locale)}</ArrowLink>
      </div>
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>

<style>
  .case-detail-hero {
    margin-top: var(--header-height);
    padding-top: 3rem;
    background: var(--color-bg);
  }

  .case-detail-hero__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .case-detail-hero__date {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .case-detail-hero__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin-bottom: 2rem;
    max-width: 800px;
  }

  .case-detail-hero__image {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .prose h2 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-top: 2.5rem;
  }

  .prose h3 {
    font-size: 1.0625rem;
    margin-top: 1.5rem;
  }
</style>
