---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConsultingContent from '../../../components/ConsultingContent.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { getConsultingContent } from '../../../data/consulting';
import { getLocale } from '../../../i18n/locale';
import { getSiteMeta } from '../../../i18n/ui';

const locale = getLocale(Astro.url);
const c = getConsultingContent(locale);
const site = getSiteMeta(locale);
---

<BaseLayout title={`${c.heroTitle} | ${site.name}`} description={c.businessBody[0]}>
  <ConsultingContent locale={locale} />
  <CtaSection locale={locale} />
</BaseLayout>
