---
import ArrowLink from '../../../components/ArrowLink.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import { getLocale, localePath } from '../../../i18n/locale';
import { getSiteMeta } from '../../../i18n/ui';

const locale = getLocale(Astro.url);
const site = getSiteMeta(locale);
const copy =
  locale === 'ja'
    ? {
        title: 'お問い合わせありがとうございます',
        pageTitle: 'お問い合わせ完了',
        p1: 'お問い合わせを受け付けました。内容を確認のうえ、担当者よりご連絡いたします。',
        p2: '返信には数日かかる場合がございます。あらかじめご了承ください。',
        back: 'トップページへ戻る',
      }
    : {
        title: 'Thank you for your inquiry',
        pageTitle: 'Message received',
        p1: 'We have received your message and will review it shortly.',
        p2: 'Please allow a few business days for a response.',
        back: 'Back to home',
      };
---

<BaseLayout title={`${copy.pageTitle} | ${site.name}`}>
  <PageHero label="CONTACT" title={copy.title} />

  <section class="section section--white">
    <div class="container prose thanks">
      <p>{copy.p1}</p>
      <p>{copy.p2}</p>
      <ArrowLink href={localePath(locale, '/')}>{copy.back}</ArrowLink>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks .arrow-link {
    margin-top: 1.5rem;
  }
</style>
