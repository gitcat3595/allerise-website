---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';
import { getLocale, localePath } from '../../i18n/locale';
import { getSiteMeta, t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const site = getSiteMeta(locale);
---

<BaseLayout title={`${t('navContact', locale)} | ${site.name}`}>
  <PageHero label="CONTACT" title={t('navContact', locale)} />

  <section class="section section--white">
    <div class="container contact-page">
      <nav class="breadcrumb">
        <a href={localePath(locale, '/')}>{t('home', locale)}</a> ・ {t('navContact', locale)}
      </nav>
      <p class="section-lead">{t('contactLead', locale)}</p>
      <ContactForm locale={locale} />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    max-width: 720px;
  }

  .contact-page .section-lead {
    margin-bottom: 2rem;
  }
</style>
