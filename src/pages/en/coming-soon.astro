---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import CtaSection from '../../components/CtaSection.astro';
import PageHero from '../../components/PageHero.astro';
import { getLocale, localePath } from '../../i18n/locale';
import { getSiteMeta, t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const site = getSiteMeta(locale);
const copy =
  locale === 'ja'
    ? {
        title: '採用情報',
        heading: '現在準備中',
        body: '情報がアップデートされ次第ページを公開いたします。今しばらくお待ちください。',
        contact: '採用に関するお問い合わせは',
        contactLink: 'お問い合わせフォーム',
        contactSuffix: 'よりご連絡ください。',
        back: 'トップページへ戻る',
      }
    : {
        title: 'Careers',
        heading: 'Coming soon',
        body: 'This page will be published once updated information is available.',
        contact: 'For recruitment inquiries, please use our ',
        contactLink: 'contact form',
        contactSuffix: '.',
        back: 'Back to home',
      };
---

<BaseLayout title={`${copy.title} | ${site.name}`}>
  <PageHero label="CAREER" title={copy.title} />

  <section class="section section--white">
    <div class="container prose coming-soon">
      <h2>{copy.heading}</h2>
      <p>{copy.body}</p>
      <p>
        {copy.contact}<a href={localePath(locale, '/contact')}>{copy.contactLink}</a>{copy.contactSuffix}
      </p>
      <ArrowLink href={localePath(locale, '/')}>{copy.back}</ArrowLink>
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>

<style>
  .coming-soon {
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
  }

  .coming-soon h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .coming-soon .arrow-link {
    justify-content: center;
    margin-top: 1.5rem;
  }
</style>
