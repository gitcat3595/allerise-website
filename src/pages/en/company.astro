---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSection from '../../components/CtaSection.astro';
import PageHero from '../../components/PageHero.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getMembers, getPartners, getValues } from '../../data/members';
import { getLocale } from '../../i18n/locale';
import { getSiteMeta, t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const site = getSiteMeta(locale);
const members = getMembers(locale);
const partners = getPartners(locale);
const values = getValues(locale);
---

<BaseLayout title={`${t('companyInfo', locale)} | ${site.name}`}>
  <PageHero label="COMPANY" title={t('companyPageTitle', locale)} image="/images/company-banner.jpg" />

  <section class="section section--white">
    <div class="container">
      <h2 class="section-label section-label--ja">{t('aboutLabel', locale)}</h2>
      <h3 class="section-title">{t('companyAboutTitle', locale)}</h3>
      <p class="prose">{t('companyAboutBody', locale)}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-label section-label--ja">MISSION</h2>
      <h3 class="section-title">{t('missionTitle', locale)}</h3>
      <p class="prose">{t('missionBody', locale)}</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2 class="section-label">MEMBERS</h2>
      <h3 class="section-title">{t('members', locale)}</h3>
      <div class="people-list">
        {members.map((m) => <PersonCard person={m} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-label">OUR VALUES</h2>
      <h3 class="section-title">{t('values', locale)}</h3>
      <div class="values-grid">
        {values.map((v) => (
          <article class="value-card">
            <h4>{v.title}</h4>
            <p>{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2 class="section-label">COMPANY PROFILE</h2>
      <h3 class="section-title">{t('companyProfile', locale)}</h3>
      <dl class="profile">
        <dt>{t('profileCompany', locale)}</dt>
        <dd>{site.company}</dd>
        <dt>{t('profileUen', locale)}</dt>
        <dd>{site.uen}</dd>
        <dt>{t('profileAddress', locale)}</dt>
        <dd>{site.registeredAddress}</dd>
        <dt>{t('profileRepresentative', locale)}</dt>
        <dd>{site.representative}</dd>
        <dt>{t('profileFounded', locale)}</dt>
        <dd>{site.founded}</dd>
        <dt>{t('profileType', locale)}</dt>
        <dd>{site.companyType}</dd>
        <dt>{t('profileActivity', locale)}</dt>
        <dd>
          {site.principalActivity}
          <span class="profile__ssic">（SSIC {site.ssic}）</span>
        </dd>
      </dl>
    </div>
  </section>

  <section class="section partners">
    <div class="container">
      <h2 class="section-label section-label--sub">PARTNERS</h2>
      <h3 class="section-title section-title--sub">{t('partners', locale)}</h3>
      <div class="people-list">
        {partners.map((p) => <PersonCard person={p} />)}
      </div>
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>

<style>
  .people-list {
    margin-top: 1rem;
  }

  /* Partners sit below the company profile as supporting information. */
  .partners {
    padding-top: 3rem;
  }

  .section-label--sub {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }

  .section-title--sub {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 1rem;
  }

  .value-card h4 {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .value-card p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .profile {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .profile dt {
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .profile dd {
    margin: 0;
  }

  .profile__ssic {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
