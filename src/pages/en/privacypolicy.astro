---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSection from '../../components/CtaSection.astro';
import PageHero from '../../components/PageHero.astro';
import { getPrivacyContent } from '../../data/privacy';
import { getLocale } from '../../i18n/locale';
import { getSiteMeta, t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const site = getSiteMeta(locale);
const privacy = getPrivacyContent(locale);
const sectionPrefix = locale === 'ja' ? '第' : 'Article ';
---

<BaseLayout title={`${t('privacy', locale)} | ${site.name}`}>
  <PageHero label="PRIVACY POLICY" title={privacy.title} />

  <section class="section section--white">
    <div class="container prose privacy">
      <p>{privacy.intro}</p>
      {privacy.body.split(/\n\n+/).map((block) => {
        if (block.startsWith(sectionPrefix) || block.startsWith('Article ')) {
          const [title, ...rest] = block.split('\n');
          return (
            <div class="privacy-section">
              <h2>{title}</h2>
              <p>{rest.join('\n')}</p>
            </div>
          );
        }
        return <p>{block}</p>;
      })}
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>

<style>
  .privacy-section h2 {
    font-size: 1.125rem;
    color: var(--color-primary);
    margin-top: 2rem;
  }
</style>
