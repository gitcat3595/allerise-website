---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import BusinessBlock from '../../components/BusinessBlock.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getBusinessLines } from '../../data/business';
import { getCases } from '../../data/cases';
import { getLocale, localePath } from '../../i18n/locale';
import { getSiteMeta, t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const site = getSiteMeta(locale);
const businessLines = getBusinessLines(locale);
const cases = getCases(locale);
const heroLines = t('heroTitle', locale).split('\n');
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__content">
      <h1 class="hero__title">
        {heroLines.map((line) => (
          <>
            {line}
            <br />
          </>
        ))}
      </h1>
      <p class="hero__subtitle">{t('heroSubtitle', locale)}</p>
    </div>
    <div class="container hero__image-wrap">
      <img
        src="/images/hero.webp"
        alt=""
        class="hero__image"
        width="1640"
        height="600"
        loading="eager"
      />
    </div>
  </section>

  <section class="section section--white" id="about">
    <div class="container split-section">
      <div>
        <h2 class="section-label section-label--ja">{t('aboutLabel', locale)}</h2>
        <h3 class="section-title">{t('aboutTitle', locale)}</h3>
        <p class="section-lead">{t('aboutLead', locale)}</p>
        <ArrowLink href={localePath(locale, '/company')}>{t('viewCompany', locale)}</ArrowLink>
      </div>
      <img
        src="/images/about-city.jpg"
        alt=""
        class="split-section__image"
        width="450"
        height="280"
        loading="lazy"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-label">{t('servicesLabel', locale)}</h2>
      <h3 class="section-title">{t('servicesTitle', locale)}</h3>
      <p class="section-lead">{t('servicesLead', locale)}</p>
      <div style="margin-top: 2rem;">
        {businessLines.slice(0, 4).map((line) => (
          <BusinessBlock line={line} locale={locale} />
        ))}
      </div>
      <div style="margin-top: 1rem;">
        <ArrowLink href={localePath(locale, '/service')}>{t('viewServices', locale)}</ArrowLink>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2 class="section-label">{t('casesLabel', locale)}</h2>
      <p class="section-lead">{t('casesLead', locale)}</p>
      <div class="grid-3" style="margin-top: 2.5rem;">
        {cases.map((c) => <CaseCard caseStudy={c} locale={locale} />)}
      </div>
      <div style="margin-top: 2rem;">
        <ArrowLink href={localePath(locale, '/case')}>{t('viewCases', locale)}</ArrowLink>
      </div>
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>

<style>
  .hero {
    margin-top: var(--header-height);
    padding: 3rem 0 0;
    background: var(--color-bg);
  }

  .hero__content {
    padding-bottom: 2rem;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .hero__subtitle {
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    margin-bottom: 0;
  }

  .hero__image-wrap {
    padding-bottom: 0;
  }

  .hero__image {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: var(--radius-image);
  }
</style>
