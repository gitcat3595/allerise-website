---
import ArrowLink from './ArrowLink.astro';
import BusinessBlock from './BusinessBlock.astro';
import CaseCard from './CaseCard.astro';
import CtaSection from './CtaSection.astro';
import { getSecondaryBusinessLines } from '../data/business';
import { getCases } from '../data/cases';
import type { Locale } from '../i18n/locale';
import { localePath } from '../i18n/locale';
import { getHomeContent } from '../i18n/home';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'ja';
const home = getHomeContent(locale);
const secondaryLines = getSecondaryBusinessLines(locale);
const cases = getCases(locale);
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{home.heroEyebrow}</p>
      <h1 class="hero__title">
        {home.heroTitle}<em>{home.heroTitleAccent}</em>{home.heroTitleRest}<br />{home.heroTitleLine2}
      </h1>
      <p class="hero__lead">{home.heroCopy}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={localePath(locale, '/contact')}>{home.heroPrimaryCta}</a>
        <a class="hero__text-link" href="#services">{home.heroSecondaryCta}　→</a>
      </div>
    </div>
    <figure class="hero__photo">
      <img
        src="/images/hero-alignment.jpg"
        alt=""
        width="1640"
        height="924"
        loading="eager"
      />
    </figure>
  </div>
</section>

<section class="section" id="services">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="label">{home.pillarsLabel}</p>
        <h2 class="section-title">{home.pillarsTitle}</h2>
        <p class="section-lead">{home.pillarsLead}</p>
      </div>
    </div>
    <div class="pillars">
      {home.pillars.map((pillar) => (
        <article class="pillar">
          <p class="pillar__num">{pillar.num}</p>
          <h3 class="pillar__title">{pillar.title}</h3>
          <p class="pillar__body">{pillar.body}</p>
          <div class="pillar__links">
            {pillar.links.map((link) => (
              <a href={localePath(locale, link.path)}>{link.label}　→</a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <p class="label">{home.otherLabel}</p>
    <h2 class="section-title">{home.otherTitle}</h2>
    <p class="section-lead">{home.otherLead}</p>
    <div style="margin-top: 2rem;">
      {secondaryLines.map((line) => (
        <BusinessBlock line={line} locale={locale} />
      ))}
    </div>
    <div style="margin-top: 1rem;">
      <ArrowLink href={localePath(locale, '/service')}>{t('viewServices', locale)}</ArrowLink>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-label">{t('casesLabel', locale)}</h2>
    <p class="section-lead">{t('casesLead', locale)}</p>
    <div class="grid-3" style="margin-top: 2.5rem;">
      {cases.map((c) => <CaseCard caseStudy={c} locale={locale} />)}
    </div>
    <div style="margin-top: 2rem;">
      <ArrowLink href={localePath(locale, '/case')}>{t('viewCases', locale)}</ArrowLink>
    </div>
  </div>
</section>

<section class="section section--white" id="about">
  <div class="container split-section">
    <img
      src="/images/about-alignment.jpg"
      alt=""
      class="split-section__image"
      width="1200"
      height="676"
      loading="lazy"
    />
    <div>
      <p class="label">{t('aboutLabel', locale)}</p>
      <h2 class="section-title">{t('companyAboutTitle', locale)}</h2>
      <p class="about-body">{t('companyAboutBody', locale)}</p>
      <ArrowLink href={localePath(locale, '/company')}>{t('viewCompany', locale)}</ArrowLink>
    </div>
  </div>
</section>

<section class="section mission">
  <div class="container mission__grid">
    <div>
      <p class="label label--inverse">MISSION</p>
      <h2 class="mission__title">{t('missionTitle', locale)}</h2>
    </div>
    <p class="mission__body">{t('missionBody', locale)}</p>
  </div>
</section>

<CtaSection locale={locale} />

<style>
  .eyebrow,
  .label {
    font-family: var(--font-en);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .label--inverse {
    color: #aebcff;
  }

  /* Hero */
  .hero {
    margin-top: var(--header-height);
    padding: 3rem 0 0;
    background: var(--color-bg-white);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: 4rem;
    align-items: center;
    padding-bottom: 3.5rem;
  }

  .hero__title {
    font-size: clamp(2.25rem, 4.2vw, 3.75rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }

  .hero__title em {
    font-style: normal;
    color: var(--color-primary);
  }

  .hero__lead {
    max-width: 620px;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 2;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 1.75rem;
  }

  .hero__text-link {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .hero__text-link:hover {
    text-decoration: underline;
  }

  .hero__photo {
    position: relative;
    margin: 0;
    height: 440px;
    overflow: hidden;
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Three pillars */
  .section-head {
    margin-bottom: 2.5rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem 1.75rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .pillar__num {
    font-family: var(--font-en);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin: 0 0 1rem;
  }

  .pillar__title {
    font-size: 1.4rem;
    line-height: 1.5;
    margin: 0 0 0.9rem;
  }

  .pillar__body {
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--color-text-muted);
    margin: 0 0 1.1rem;
  }

  .pillar__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .pillar__links a {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .pillar__links a:hover {
    text-decoration: underline;
  }

  .mission {
    background: var(--color-primary);
    color: #fff;
  }

  .mission__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 4rem;
    align-items: start;
  }

  .mission__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    margin: 0;
  }

  .mission__body {
    margin: 0;
    line-height: 2;
    color: #dbe1ff;
  }

  .about-body {
    max-width: 620px;
    color: var(--color-text-muted);
    line-height: 2;
    margin: 0 0 1.5rem;
  }

      @media (max-width: 900px) {
    .hero__grid,
    .mission__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .hero__photo {
      height: 320px;
    }

    .pillars {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 600px) {
    .hero__title {
      font-size: 2.1rem;
    }

    .hero__photo {
      height: 250px;
    }

  }
</style>
