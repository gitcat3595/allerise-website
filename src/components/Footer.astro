---
import type { Locale } from '../i18n/locale';
import { localePath } from '../i18n/locale';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'ja';
const year = new Date().getFullYear();
const footerLinks = [
  { href: localePath(locale, '/service/new-business-development'), label: t('navBusiness', locale) },
  { href: localePath(locale, '/service/training'), label: t('navTraining', locale) },
  { href: localePath(locale, '/service/individual'), label: t('navIndividual', locale) },
  { href: localePath(locale, '/case'), label: t('navCase', locale) },
  { href: localePath(locale, '/company'), label: t('navCompany', locale) },
  { href: localePath(locale, '/contact'), label: t('navContact', locale) },
  { href: localePath(locale, '/privacypolicy'), label: t('privacy', locale) },
];
---

<footer class="footer">
  <div class="container">
    <nav class="footer__nav" aria-label={t('footerNav', locale)}>
      <ul>
        {footerLinks.map((item) => (
          <li>
            <a href={item.href} class:list={[{ 'footer__external': item.external }]}>
              {item.label}
              {item.external && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="footer__brand">
      <p class="footer__company">Allerise Pte. Ltd.</p>
      <p class="footer__locations">Singapore</p>
    </div>
    <p class="footer__copy">© Allerise Pte. Ltd. {year}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-footer);
    color: #fff;
    padding: 2.5rem 0 2rem;
    text-align: center;
  }

  .footer__nav ul {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
  }

  .footer__nav a {
    color: #fff;
    font-size: 0.8125rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer__nav a:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .footer__brand {
    margin-bottom: 1.5rem;
  }

  .footer__company {
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0 0 0.25rem;
  }

  .footer__locations {
    font-size: 0.875rem;
    margin: 0;
    opacity: 0.9;
  }

  .footer__copy {
    font-size: 0.75rem;
    opacity: 0.85;
    margin: 0;
  }
</style>
