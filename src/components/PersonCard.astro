---
import type { Person } from '../data/members';

interface Props {
  person: Person;
}

const { person } = Astro.props;
---

<article class="person-card">
  <img src={person.image} alt={person.name} class="person-card__photo" width="400" height="400" loading="lazy" />
  <div class="person-card__body">
    <h3>{person.name}</h3>
    <p class="person-card__role">{person.role}</p>
    <p class="person-card__bio">{person.bio}</p>
  </div>
</article>

<style>
  .person-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    align-items: start;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .person-card:last-child {
    border-bottom: none;
  }

  .person-card__photo {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: var(--radius-image);
    background: var(--color-border);
  }

  .person-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .person-card__role {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .person-card__bio {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.8;
  }

  @media (max-width: 600px) {
    .person-card {
      grid-template-columns: 1fr;
    }

    .person-card__photo {
      width: 100%;
      height: 220px;
    }
  }
</style>
