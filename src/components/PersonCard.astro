---
import type { Person } from '../data/members';

interface Props {
  person: Person;
}

const { person } = Astro.props;
---

<article class="person-card card">
  <img src={person.image} alt={person.name} class="person-card__photo" width="400" height="400" loading="lazy" />
  <div class="person-card__body">
    <h3>{person.name}</h3>
    <p class="person-card__role">{person.role}</p>
    <p>{person.bio}</p>
  </div>
</article>

<style>
  .person-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    align-items: start;
    padding: 1.5rem;
  }

  .person-card__photo {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
    background: var(--color-bg-alt);
  }

  .person-card h3 {
    margin-bottom: 0.25rem;
  }

  .person-card__role {
    color: var(--color-primary);
    font-weight: 500;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 600px) {
    .person-card {
      grid-template-columns: 1fr;
    }

    .person-card__photo {
      width: 100%;
      height: 200px;
    }
  }
</style>
