---
import type { CaseStudy } from '../data/cases';
import type { Locale } from '../i18n/locale';
import { localePath } from '../i18n/locale';

interface Props {
  caseStudy: CaseStudy;
  heading?: 'h2' | 'h3';
  locale?: Locale;
}

const { caseStudy, heading = 'h3', locale = 'ja' } = Astro.props;
const TitleTag = heading;
---

<a href={localePath(locale, `/case/${caseStudy.slug}`)} class="case-card">
  <img src={caseStudy.image} alt="" class="case-card__image" width="800" height="450" loading="lazy" />
  <div class="case-card__body">
    <span class="case-card__tag">{caseStudy.category}</span>
    <time class="case-card__date">{caseStudy.date}</time>
    <TitleTag class="case-card__title">{caseStudy.title}</TitleTag>
  </div>
</a>

<style>
  .case-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }

  .case-card:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .case-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-border);
    border-radius: var(--radius-image);
    margin-bottom: 1rem;
  }

  .case-card__body {
    padding: 0;
  }

  .case-card__tag {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--color-primary);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .case-card__date {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .case-card__title {
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.5;
  }
</style>
