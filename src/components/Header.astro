---
import type { Locale } from '../i18n/locale';
import { alternateLocalePath } from '../i18n/locale';
import { getNav, t } from '../i18n/ui';
import { localePath } from '../i18n/locale';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'ja';
const nav = getNav(locale);
const currentPath = Astro.url.pathname;
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/$/, '') : path);
const current = normalize(currentPath);
const isTrainingPage = current.endsWith('/service/training');
const isServiceSection = current.includes('/service') && !isTrainingPage;
const langHref = alternateLocalePath(currentPath);
---

<header class="header">
  <div class="container header__inner">
    <a href={localePath(locale, '/')} class="header__logo">
      <img src="/images/logo.png" alt="Allerise" class="header__logo-img" width="160" height="48" />
    </a>
    <button class="header__toggle" aria-label={t('menuOpen', locale)} aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav class="header__nav" aria-label={t('mainNav', locale)}>
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'header__link',
                {
                  'is-active': item.href.endsWith('/service/training')
                    ? isTrainingPage
                    : item.href.endsWith('/service')
                      ? isServiceSection
                      : item.href.endsWith('/case')
                        ? current.includes('/case')
                        : current === normalize(item.href),
                },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href={langHref} class="header__link header__lang">
            {t('langSwitch', locale)}
          </a>
        </li>
      </ul>
    </nav>
    <a href={localePath(locale, '/contact')} class="header__contact">
      <span>{t('navContact', locale)}</span>
      <svg class="header__contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector('.header__toggle');
  const navEl = document.querySelector('.header__nav');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    navEl?.classList.toggle('is-open');
    toggle.classList.toggle('is-open');
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    background: var(--color-bg);
  }

  .header__inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 2rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo:hover {
    text-decoration: none;
    opacity: 0.9;
  }

  .header__logo-img {
    height: 40px;
    width: auto;
    display: block;
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.625rem 0;
    border-bottom: 2px solid transparent;
  }

  .header__link:hover,
  .header__link.is-active {
    color: var(--color-text);
    text-decoration: none;
    border-bottom-color: var(--color-text);
  }

  .header__lang {
    color: var(--color-primary);
  }

  .header__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__contact:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  .header__contact-icon {
    flex-shrink: 0;
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }

  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    transition: transform 0.2s;
  }

  @media (max-width: 900px) {
    .header__toggle {
      display: flex;
    }

    .header__nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem;
      display: none;
    }

    .header__nav.is-open {
      display: block;
    }

    .header__nav ul {
      flex-direction: column;
      gap: 0;
    }

    .header__link {
      display: block;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-border);
    }

    .header__contact {
      display: none;
    }
  }
</style>
