---
interface Props {
  href: string;
  variant?: 'default' | 'inverse' | 'external' | 'inverse-external';
}

const { href, variant = 'default' } = Astro.props;
const isInverse = variant === 'inverse' || variant === 'inverse-external';
const isExternal = variant === 'external' || variant === 'inverse-external';
---

<a href={href} class:list={['arrow-link', { 'arrow-link--inverse': isInverse }]}>
  <span class="arrow-link__icon" aria-hidden="true">
    {isExternal ? (
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
        <polyline points="15 3 21 3 21 9" />
        <line x1="10" y1="14" x2="21" y2="3" />
      </svg>
    ) : (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    )}
  </span>
  <span class="arrow-link__text"><slot /></span>
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }

  .arrow-link:hover {
    opacity: 0.85;
    text-decoration: none;
  }

  .arrow-link__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-primary);
    color: #fff;
  }

  .arrow-link--inverse {
    color: #fff;
  }

  .arrow-link--inverse .arrow-link__icon {
    background: #fff;
    color: var(--color-primary);
  }
</style>
