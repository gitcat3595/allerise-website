---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'お問い合わせ', description = 'サービスに関するご質問や、取材・パートナーシップのご相談などはこちらからお気軽にご連絡ください。' } = Astro.props;
---

<section class="cta section section--alt">
  <div class="container cta__inner">
    <div>
      <p class="section-label">WORK WITH US</p>
      <h2 class="section-title">{title}</h2>
      <p class="section-lead">{description}</p>
    </div>
    <div class="cta__actions">
      <a href="/contact" class="btn btn--primary">お問い合わせはこちら</a>
      <a href="/coming-soon" class="btn btn--outline">採用情報はこちら</a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
