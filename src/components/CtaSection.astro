---
import type { Locale } from '../i18n/locale';
import { localePath } from '../i18n/locale';
import { t } from '../i18n/ui';
import ArrowLink from './ArrowLink.astro';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'ja';
---

<section class="cta">
  <div class="cta__grid">
    <div class="cta__col">
      <h2 class="cta__title">{t('ctaContactTitle', locale)}</h2>
      <p class="cta__text">{t('ctaContactText', locale)}</p>
      <ArrowLink href={localePath(locale, '/contact')} variant="inverse">{t('contactCta', locale)}</ArrowLink>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-primary);
    color: #fff;
  }

  .cta__grid {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .cta__col {
    padding: 4rem 3rem;
  }

  .cta__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: #fff;
  }

  .cta__text {
    margin-bottom: 2rem;
    line-height: 1.8;
    max-width: 420px;
  }

  @media (max-width: 768px) {
    .cta__col {
      padding: 3rem 1.5rem;
    }
  }
</style>
